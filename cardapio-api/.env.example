# =====================================================================
# TEMPLATE DE CONFIGURAÇÃO DE AMBIENTE (.env) - CARDÁPIO API
# Copie este arquivo para .env e preencha com suas configurações locais:
#   cp .env.example .env
#
# AVISO: O arquivo .env NUNCA deve ser commitado no Git (já está no .gitignore).
# =====================================================================

# ---------------------------------------------------------------------
# OPÇÃO 1: PostgreSQL Local (Instância já instalada na máquina)
# Formato: postgresql://<usuario>:<senha>@<host>:<porta>/<nome_do_banco>
# Exemplo de comando para criar o banco: createdb cardapio_db
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://<usuario>:<sua_senha>@localhost:5432/cardapio_db

# ---------------------------------------------------------------------
# OPÇÃO 2: Supabase (PostgreSQL na Nuvem)
# Copie a Connection String (URI) no painel do Supabase:
# Settings -> Database -> Connection String (modo Pooler / Transaction ou Session)
# ---------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.<project_ref>:<sua_senha>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ---------------------------------------------------------------------
# OPÇÃO 3: Fallback Didático SQLite Local (arquivo embutido)
# Use caso queira testar rapidamente sem o serviço de PostgreSQL ativo
# ---------------------------------------------------------------------
# DATABASE_URL=sqlite:///./cardapio.db

# Configurações Gerais da Aplicação
ENVIRONMENT=development
DEBUG=true
APP_NAME=Cardápio Digital - IFPI TDS 386
